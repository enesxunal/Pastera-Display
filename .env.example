# Sunucu portu (yerel geliştirme)
PORT=3000

# Admin giriş şifresi (ilk kurulumda otomatik oluşturulur: admin / pastera123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pastera123

# JWT gizli anahtar (üretimde mutlaka değiştirin)
JWT_SECRET=pastera-gizli-anahtar-degistirin

# Saat dilimi (Almanya)
TZ=Europe/Berlin

# Vercel Postgres (Vercel'de otomatik gelir)
# DATABASE_URL=postgres://...

# Vercel Blob (medya dosyaları için - Vercel'de gerekli)
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# Ortam: development | production
NODE_ENV=development
